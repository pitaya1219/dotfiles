# Gitea MCP Server Configuration
# Copy this file to your project root as .envrc and run: direnv allow

export GITEA_HOST="$(passage show homelab/gitea/host 2>/dev/null)"
export GITEA_ACCESS_TOKEN="$(passage show homelab/gitea/claude-bot/token 2>/dev/null)"
export GITEA_CLAUDE_BOT_TOKEN="$(passage show homelab/gitea/claude-bot/token 2>/dev/null)"
export GITEA_AI_BOT_TOKEN="$(passage show homelab/gitea/ai-bot/token 2>/dev/null)"
export GITEA_VIBE_BOT_TOKEN="$(passage show homelab/gitea/mistral-bot/token 2>/dev/null)"

# Filter Gitea MCP tools to reduce token consumption
export GITEA_TOOLS="get_me,list_my_repos,search_repos,get_file_contents,get_dir_contents,list_branches,create_branch,list_commits,get_commit,issue_read,issue_write,list_issues,search_issues,pull_request_read,pull_request_write,list_pull_requests,list_releases,create_release,get_latest_release"