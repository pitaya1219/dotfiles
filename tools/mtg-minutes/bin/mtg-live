#!/usr/bin/env python3
"""
mtg-live — 会議の「相手の声」をリアルタイム文字起こししてターミナルに表示する。
1on1などで相手の発言をさっと見返す補助用。

録音しながら自分/相手の両方の字幕を出したいなら `mtg` を使う(これはその片側だけ)。

音声経路(初回セットアップが必要):
    通話アプリの出力 → 複数出力装置(ヘッドホン + BlackHole 16ch)
                              │(自分は普通に聞ける)
                              ▼
                   BlackHole 16ch を whisper-stream が読む → 字幕

使い方:
    mtg-live                         # 既定デバイス(BlackHole 16ch)で開始
    mtg-live --list                  # キャプチャデバイス一覧
    mtg-live --device "BlackHole 16ch"
    mtg-live --model small           # 軽量(既定はturbo=高精度)
    mtg-live --translate             # 相手の発言を英語にライブ翻訳
    mtg-live --no-save               # ログファイルへの保存をやめ、標準出力のみにする

字幕は既定で ~/Documents/mtg-minutes/live/ にもファイル保存される
(録音が失敗した場合のフォールバックとして相手発言の記録を残すため)。

Ctrl-C で終了。
"""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from mtgcommon import SIDES, add_live_args, run_single_side  # noqa: E402

SIDE = "other"


def main():
    ap = argparse.ArgumentParser(
        prog="mtg-live", description=f"{SIDES[SIDE]['label']}の声をリアルタイム文字起こし")
    add_live_args(ap, SIDE)
    run_single_side(SIDE, ap.parse_args())


if __name__ == "__main__":
    main()
