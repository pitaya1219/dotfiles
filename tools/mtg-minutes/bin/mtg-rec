#!/usr/bin/env python3
"""
mtg-rec — OBSを使わずにコマンドで会議を2トラック録音する小ツール。
  Track1 = 自分の声  (BlackHole 2ch ← OBS+RNNoise後のクリーン音声)
  Track2 = 相手の声  (BlackHole 16ch ← Multi-Output Device経由)

録音した .mkv はそのまま mtg-minutes に渡せる(2トラック=話者分離つき)。

前提:
  - 通常の会議セットアップ(物理マイク → OBS(RNNoise) → BlackHole 2ch)が動いていること。
    = OBSを起動し、マイクのモニタリングがBlackHole 2chに出ている状態。
    ※ OBSを使わず生マイクで録るなら --self-device "UAB-80" 等で上書き。
  - Multi-Output Device(ヘッドホン + BlackHole 16ch)を作成し、
    通話アプリ/システムの出力先に指定しておくこと(相手の声がBlackHole 16chに乗る)。

使い方:
    mtg-rec                          # 録音開始、Ctrl-C で停止
    mtg-rec --minutes "1on1 田中"     # 停止後そのまま議事録生成まで実行
    mtg-rec --duration 30            # 30秒で自動停止(テスト用)
    mtg-rec --list                   # 録音デバイス一覧
    mtg-rec --live-silence-sec 0     # 録音中の無音警告を無効化

録音中、各トラックを別プロセスでもう一系統開いてsilencedetectを回し、
一定秒数(既定120秒)以上無音が続いたらその場でターミナルに警告する。
録音停止後にもファイル全体をサンプリングして無音チェックを行う
(こちらは会議中の検知漏れ・OFFにした場合のフォールバック)。
"""
import argparse
import os
import re
import subprocess
import sys
import threading
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from mtgcommon import (  # noqa: E402
    LIVE_SILENCE_ALERT_SEC_DEFAULT, MEETING_OUTPUT_DEVICE, OUT_DIR, SIDES,
    MeetingOutput, die, info, print_minutes_hint, resolve_device, sibling,
    stamp, warn,
)

SELF_DEVICE = SIDES["self"]["device"]
OTHER_DEVICE = SIDES["other"]["device"]

# 無音チェック: 録音全体に等間隔でサンプル窓をとり、無音(閾値未満)だった窓の
# 割合が高ければ「そのトラックは録れていない疑いがある」と警告する。
# 数点だけのサンプリングだと、区間の一部だけ音声モニタリングが復旧していた
# ような断続的な無音(実際に発生した障害パターン)を見逃すため密にサンプルする。
# (現実の会話は概ね-20〜-50dB、デバイス未接続/モニタ経路断時の無音床は-90dB前後)
SILENCE_THRESHOLD_DB = -50.0
SILENCE_SAMPLE_WINDOW_SEC = 20
SILENCE_SAMPLE_INTERVAL_SEC = 120  # この間隔でサンプル数を決める
SILENCE_MIN_SAMPLES = 5
SILENCE_MAX_SAMPLES = 15
SILENCE_FRACTION_THRESHOLD = 0.6  # サンプル窓のこの割合以上が無音なら警告

# ライブ無音検知: 録音本体とは別に、同じデバイスをもう一系統 ffmpeg で開いて
# silencedetect フィルタだけ回し、既定秒数以上無音が続いたらその場で警告する
# (秒数の既定値は mtgcommon の LIVE_SILENCE_ALERT_SEC_DEFAULT)。
# BlackHole は複数プロセスからの同時読み出しに対応しているため競合しない
# (実機で検証済み)。事後チェック(check_track_silence)は「会議後に気づく」
# ためのフォールバックであり、会議中に気づけないと対処のしようがないので
# こちらが本命。

DEV_RE = re.compile(r"\[(\d+)\]\s+(.+)")
MEAN_VOLUME_RE = re.compile(r"mean_volume:\s*(-?\d+(?:\.\d+)?)\s*dB")


def list_audio_devices():
    """avfoundation のオーディオ入力デバイス [(idx, name), ...]"""
    res = subprocess.run(
        ["ffmpeg", "-f", "avfoundation", "-list_devices", "true", "-i", ""],
        capture_output=True, text=True,
    )
    devices, in_audio = [], False
    for line in res.stderr.splitlines():
        if "AVFoundation audio devices" in line:
            in_audio = True
            continue
        if in_audio:
            m = DEV_RE.search(line)
            if m:
                devices.append((int(m.group(1)), m.group(2).strip()))
    return devices


def probe_channels(dev_idx):
    """デバイスのチャンネル数を返す。取れなければ 0。

    avfoundation は開いてみるまでチャンネル数が分からないので、
    ごく短時間だけ開いて astats のチャンネル別出力を数える。
    """
    res = subprocess.run(
        ["ffmpeg", "-f", "avfoundation", "-i", f":{dev_idx}", "-t", "0.3",
         "-af", "astats=metadata=1:reset=0", "-f", "null", "-"],
        capture_output=True, text=True,
    )
    chans = [int(m.group(1)) for m in re.finditer(r"Channel:\s*(\d+)", res.stderr)]
    return max(chans) if chans else 0


def downmix_filter(n_channels):
    """全チャンネルを素直に足してモノラルに落とす pan 式を作る。

    チャンネル位置を決め打ちできないため、全部足す。
    BlackHole 16ch のような多chデバイスでは、複数出力装置が音声を
    どのチャンネルに書くかがユーザーの Audio MIDI 設定次第で変わる
    (実機では ch3 に乗っていて、先頭2chには -46dB の残留しか無かった)。
    先頭2ch決め打ちだと、そこが無音のとき「録れているのにノイズだけ」という
    最悪の失敗をする。無音チャンネルは足しても 0 なので、全部足すのが安全。

    ffmpeg 標準のダウンミックス(-ac 1)でも音は拾えるが、レイアウト上の
    役割ごとに係数がかかって 17dB ほど痩せる(実測)。等倍で足す方を採る。
    """
    if n_channels <= 1:
        return None
    terms = "+".join(f"c{i}" for i in range(n_channels))
    return f"pan=mono|c0={terms}"


def probe_duration(path):
    """ffprobe で録音時間(秒)を取得。失敗時は None。"""
    res = subprocess.run(
        ["ffprobe", "-v", "error", "-show_entries", "format=duration",
         "-of", "default=noprint_wrappers=1:nokey=1", str(path)],
        capture_output=True, text=True,
    )
    try:
        return float(res.stdout.strip())
    except ValueError:
        return None


def sample_mean_volume(path, track_index, start, length):
    """指定トラック・区間の mean_volume(dB)を測定。失敗時は None。"""
    res = subprocess.run(
        ["ffmpeg", "-ss", str(start), "-t", str(length), "-i", str(path),
         "-map", f"0:{track_index}", "-af", "volumedetect", "-f", "null", "-"],
        capture_output=True, text=True,
    )
    m = MEAN_VOLUME_RE.search(res.stderr)
    return float(m.group(1)) if m else None


def check_track_silence(path, track_index, duration):
    """録音全体を等間隔サンプリングし、無音だった窓の割合が高ければそのトラックが
    無音疑いだと判定する。戻り値: (無音疑いか, 無音割合, サンプル数) / 測定不能なら None。"""
    if not duration or duration <= 0:
        return None
    n_samples = max(SILENCE_MIN_SAMPLES, min(SILENCE_MAX_SAMPLES, round(duration / SILENCE_SAMPLE_INTERVAL_SEC)))
    window = min(SILENCE_SAMPLE_WINDOW_SEC, duration)
    offsets = sorted({max(0.0, min(duration - window, duration * (i + 0.5) / n_samples))
                       for i in range(n_samples)})
    levels = [sample_mean_volume(path, track_index, off, window) for off in offsets]
    levels = [l for l in levels if l is not None]
    if not levels:
        return None
    silent_count = sum(1 for l in levels if l < SILENCE_THRESHOLD_DB)
    fraction = silent_count / len(levels)
    return fraction >= SILENCE_FRACTION_THRESHOLD, fraction, len(levels)


class SilenceMonitor:
    """録音中、指定デバイスを別プロセスで並行に開き silencedetect だけ回して
    無音をリアルタイムに警告する。録音本体のffmpegとは別プロセス。"""

    def __init__(self, device_idx, label, extra_af, threshold_db, alert_sec):
        self.device_idx = device_idx
        self.label = label
        self.threshold_db = threshold_db
        self.alert_sec = alert_sec
        af = f"silencedetect=noise={threshold_db}dB:d={alert_sec}"
        if extra_af:
            af = f"{extra_af},{af}"
        self.cmd = ["ffmpeg", "-f", "avfoundation", "-i", f":{device_idx}",
                    "-af", af, "-f", "null", "-"]
        self.proc = None
        self.thread = None
        self.opened = False   # デバイスを開けたことが確認できたか
        self.failed = False
        self.stopping = False  # stop()呼び出し後はffmpeg終了時のflushメッセージを無視

    def start(self):
        try:
            self.proc = subprocess.Popen(
                self.cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True,
            )
        except FileNotFoundError:
            self.failed = True
            return
        self.thread = threading.Thread(target=self._read_loop, daemon=True)
        self.thread.start()

    def _read_loop(self):
        for line in self.proc.stderr:
            if "Stream mapping" in line or "Output #0" in line:
                self.opened = True
            if self.stopping:
                continue
            if "silence_start" in line:
                warn(f"{self.label}側が{self.alert_sec}秒以上無音です。"
                     f"マイク/OBSのAudio Monitoring経路を確認してください。")
            elif "silence_end" in line:
                info(f"{self.label}側の音声が復帰しました。")
        if not self.opened:
            self.failed = True

    def stop(self):
        if self.proc is None:
            return
        self.stopping = True
        self.proc.terminate()
        try:
            self.proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            self.proc.kill()
            self.proc.wait()
        if self.thread:
            self.thread.join(timeout=2)


def main():
    ap = argparse.ArgumentParser(prog="mtg-rec", description="OBSなしで会議を2トラック録音")
    ap.add_argument("--list", action="store_true", help="録音デバイス一覧を表示して終了")
    ap.add_argument("--self-device", default=SELF_DEVICE, help=f"自分のマイク (既定: {SELF_DEVICE})")
    ap.add_argument("--other-device", default=OTHER_DEVICE, help=f"相手の声 (既定: {OTHER_DEVICE})")
    ap.add_argument("--duration", type=int, default=0, help="指定秒で自動停止(0=Ctrl-Cまで)")
    ap.add_argument("--out", default="", help="出力ファイルパス(既定: ~/Movies/mtg_日時.mkv)")
    ap.add_argument("--minutes", nargs="?", const="", default=None,
                    metavar="TITLE", help="録音停止後に mtg-minutes を実行(タイトル任意)")
    ap.add_argument("--output-device", default=MEETING_OUTPUT_DEVICE,
                    help=f"録音中に切り替えるシステム出力デバイス名 (既定: {MEETING_OUTPUT_DEVICE})")
    ap.add_argument("--no-switch-output", action="store_true",
                    help="システム出力デバイスの自動切り替えをスキップ")
    ap.add_argument("--live-silence-sec", type=int, default=LIVE_SILENCE_ALERT_SEC_DEFAULT,
                    help=f"録音中この秒数以上無音が続いたら警告 (既定: {LIVE_SILENCE_ALERT_SEC_DEFAULT}秒、0で無効化)")
    # mtg から呼ばれるとき用。トップレベルのコマンドとして喋る前提の案内
    # (自動停止の予告、終了時の議事録化コマンド)をまとめて黙らせる。
    # 個別のメッセージごとにフラグを足すと、mtg 側にも「これは出す/出さない」
    # の分岐が増えていくので、まとめて1つのスイッチにしてある。
    ap.add_argument("--quiet-ui", action="store_true",
                    help="トップレベル向けの案内を出さない(mtg から呼ばれる時など)")
    args = ap.parse_args()

    devices = list_audio_devices()
    if args.list:
        print("録音デバイス一覧:")
        for idx, name in devices:
            tag = ""
            if args.self_device.lower() in name.lower():
                tag = "  ← 自分"
            elif args.other_device.lower() in name.lower():
                tag = "  ← 相手"
            print(f"  [{idx}] {name}{tag}")
        return

    self_idx, self_name = resolve_device(devices, args.self_device)
    other_idx, other_name = resolve_device(devices, args.other_device)
    if self_idx is None:
        die(f"自分のマイク '{args.self_device}' が見つかりません。--list で確認を。")
    if other_idx is None:
        die(f"相手デバイス '{args.other_device}' が見つかりません。\n"
            f"  Multi-Output Device作成 & BlackHole 16ch導入を確認してください。--list で確認を。")

    if args.out:
        out = Path(args.out).expanduser()
    else:
        OUT_DIR.mkdir(parents=True, exist_ok=True)
        out = OUT_DIR / f"mtg_{stamp()}.mkv"

    # デバイスごとに別プロセスで録り、停止後に1本の mkv へ束ねる。
    #
    # 単一の ffmpeg で avfoundation を2つ開くと「最初の入力」が壊れる。
    # 音量は正常に見えるのに中身が音声にならず、whisper が延々と
    # 「ご視聴ありがとうございました」を返す形で表面化した。実機での確認:
    #   :0 単独            → 正しく文字起こしできる
    #   :0 を先、:3 を後   → :0 が壊れる
    #   :3 を先、:0 を後   → :0 は正常(壊れるのは常に先頭の入力)
    # 相手側が2番目だったため、相手だけ無事という分かりにくい壊れ方をしていた。
    #
    # 各入力は全チャンネルを足してモノラルに落とす
    # (どのチャンネルに音が乗るかは環境依存のため)。
    self_ch = probe_channels(self_idx)
    other_ch = probe_channels(other_idx)
    parts, procs = [], []
    for label, dev_idx, n_ch in (("self", self_idx, self_ch),
                                 ("other", other_idx, other_ch)):
        part = out.with_suffix(f".{label}.mka")
        cmd = ["ffmpeg", "-y", "-f", "avfoundation", "-i", f":{dev_idx}"]
        f = downmix_filter(n_ch)
        if f:
            cmd += ["-af", f]
        cmd += ["-c:a", "aac", "-b:a", "128k"]
        if args.duration > 0:
            cmd += ["-t", str(args.duration)]
        cmd.append(str(part))
        parts.append((label, part, cmd))

    info(f"自分: [{self_idx}] {self_name} ({self_ch}ch)"
         f"  /  相手: [{other_idx}] {other_name} ({other_ch}ch)")
    info(f"録音先: {out}")
    if not args.quiet_ui:
        if args.duration > 0:
            info(f"{args.duration}秒で自動停止します")
        else:
            info("録音中… \033[1mCtrl-C で停止\033[0m")

    # 録音前: システム出力デバイスを「会議用」に切り替え。
    # mtg から呼ばれるときは mtg 側が持つので --no-switch-output が渡ってくる。
    meeting_output = MeetingOutput(args.output_device, not args.no_switch_output)
    meeting_output.__enter__()

    # ライブ無音検知: 録音本体とは別プロセスで同じデバイスをもう一系統開く
    self_monitor = other_monitor = None
    if args.live_silence_sec > 0:
        # 録音本体と同じダウンミックスをかけてから判定する。多chデバイスを
        # そのまま silencedetect に通すと、無音チャンネルに引きずられて
        # 「音は録れているのに無音」と誤検知する。
        self_monitor = SilenceMonitor(self_idx, "自分", downmix_filter(self_ch),
                                       SILENCE_THRESHOLD_DB, args.live_silence_sec)
        other_monitor = SilenceMonitor(other_idx, "相手", downmix_filter(other_ch),
                                        SILENCE_THRESHOLD_DB, args.live_silence_sec)
        self_monitor.start()
        other_monitor.start()
        # 起動失敗(デバイス競合など)を録音開始直後に検知して知らせる
        time.sleep(1.5)
        for m in (self_monitor, other_monitor):
            if m.proc.poll() is not None:
                m.failed = True
        if self_monitor.failed or other_monitor.failed:
            for m in (self_monitor, other_monitor):
                if m.failed:
                    warn(f"{m.label}側のライブ無音検知を開始できませんでした(デバイス競合の可能性)。"
                         f"録音停止後のチェックのみになります。")
        else:
            info(f"ライブ無音検知を開始しました({args.live_silence_sec}秒以上無音で警告)")

    # ffmpegのstderrは事後診断のためログファイルに残す(DEVNULLに捨てない)
    ffmpeg_log = out.with_suffix(".log")
    with open(ffmpeg_log, "w") as logf:
        for label, part, cmd in parts:
            logf.write(f"=== {label}: {' '.join(cmd)}\n")
            logf.flush()
            procs.append(subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=logf))
        try:
            try:
                for p in procs:
                    p.wait()
            except KeyboardInterrupt:
                # Ctrl-C は ffmpeg にも届く。finalize を待つ。
                for p in procs:
                    try:
                        p.wait(timeout=10)
                    except subprocess.TimeoutExpired:
                        p.terminate()
                        p.wait()
        finally:
            if self_monitor:
                self_monitor.stop()
            if other_monitor:
                other_monitor.stop()
            # 録音後: 出力デバイスを元に戻す
            meeting_output.__exit__()

        # 別々に録った2本を1本の mkv(トラック0=自分 / 1=相手)にまとめる。
        # 再エンコードはしないので大きさに関わらず一瞬で終わる。
        missing = [str(p) for _, p, _ in parts if not p.exists() or p.stat().st_size < 1024]
        if missing:
            die(f"録音ファイルが作成されませんでした。ffmpegのログを確認してください: {ffmpeg_log}")
        merge = ["ffmpeg", "-y"]
        for _, part, _ in parts:
            merge += ["-i", str(part)]
        merge += ["-map", "0:a", "-map", "1:a", "-c", "copy", str(out)]
        logf.write(f"=== merge: {' '.join(merge)}\n")
        logf.flush()
        subprocess.run(merge, stdout=subprocess.DEVNULL, stderr=logf)
    print()
    if not out.exists() or out.stat().st_size < 1024:
        die(f"録音の結合に失敗しました。ffmpegのログを確認してください: {ffmpeg_log}")
    for _, part, _ in parts:
        part.unlink(missing_ok=True)
    info(f"\033[32m録音完了\033[0m: {out}  ({out.stat().st_size//1024} KB)")

    # 無音チェック: OBSのAudio Monitoringが復旧しないまま録れてしまうケースなどを検知
    info("無音チェック中…")
    duration = probe_duration(out)
    self_result = check_track_silence(out, 0, duration)
    other_result = check_track_silence(out, 1, duration)
    silent = [(label, result) for label, result in (("自分", self_result), ("相手", other_result))
              if result is not None and result[0]]
    if silent:
        for label, (_, fraction, n) in silent:
            warn(f"{label}側トラックが無音の疑いがあります"
                 f"(サンプル{n}箇所中 {round(fraction * n)}箇所が無音)")
        warn("OBSのAudio Monitoring(UA80など)を一度OFF→ONにしてから再度録音し直すことを検討してください。")

    # そのまま議事録生成
    if args.minutes is not None:
        title = args.minutes or out.stem
        exe = sibling("mtg-minutes")
        info(f"議事録を生成します: {exe} {out} --title \"{title}\"")
        os.execvp(exe, [exe, str(out), "--title", title])
    elif not args.quiet_ui:
        print_minutes_hint(recording=out)


if __name__ == "__main__":
    main()
