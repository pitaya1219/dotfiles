#!/usr/bin/env python3
"""
mtg-minutes — OBS録音から「話者ラベル付き文字起こし」と「議事録」を生成し、
オプションで Logseq に会議ページを作成する。

音声処理は全てローカル(ffmpeg + whisper.cpp)。Claude に渡すのは最終テキストのみ。

使い方:
    mtg-minutes RECORDING.mkv [--title "1on1 田中さん"] [options]
    mtg-minutes --transcript LIVE.txt [--title ...]   # 既存の文字起こしから作る

前提:
    - ffmpeg (brew)
    - whisper-cli (brew install whisper-cpp)
    - claude CLI (議事録生成。--no-minutes でスキップ可)
    - logseq-db (任意。--no-logseq でスキップ)

OBS の 2トラック録音(Track1=自分のマイク / Track2=相手のアプリ音声)を想定。
トラックが1つしか無い場合は話者ラベルなしで処理する。
"""
import argparse
import datetime as dt
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from mtgcommon import (CONFIG_FILE, MODELS, SIDES, TEAM_PROJECTS, VAD_MODEL, die, info,  # noqa: E402
                       page_tags, team_title, warn)
import nextcloud  # noqa: E402

# ---------------------------------------------------------------------------
# 設定(環境変数 or ~/.config/mtg-minutes/config.json で上書き可)
# ---------------------------------------------------------------------------
DEFAULTS = {
    "model": str(MODELS["turbo"]),
    "vad_model": str(VAD_MODEL),
    "normalize": True,           # 抽出時にラウドネス正規化をかけるか
    "whisper_bin": "whisper-cli",
    "language": "ja",
    # ライブ字幕(mtgcommon.SIDES)と同じ値を使う。こことライブ側で食い違うと、
    # 同じ会議なのに録音経由と --transcript 経由で話者名が変わってしまう。
    "self_label": SIDES["self"]["label"],
    "other_label": SIDES["other"]["label"],
    "logseq_page_prefix": "会議録",
    "claude_bin": "claude",
    "output_dir": str(Path.home() / "Documents/mtg-minutes"),
    "attach_audio": True,            # 録音音声をLogseqに添付するか
    "audio_bitrate": "96k",          # 添付音声(m4a)のビットレート
    # 3つとも設定すると録音音声と文字起こし全文を Nextcloud に置く
    "nextcloud_url_cmd": "",
    "nextcloud_user_cmd": "",
    "nextcloud_password_cmd": "",
}


def load_config():
    cfg = dict(DEFAULTS)
    if CONFIG_FILE.exists():
        try:
            cfg.update(json.loads(CONFIG_FILE.read_text()))
        except Exception as e:
            warn(f"config.json の読み込みに失敗: {e}")
    # 環境変数 (MTG_MODEL, ...) で上書き
    for k in cfg:
        env = os.environ.get("MTG_" + k.upper())
        if env:
            cfg[k] = env
    return cfg


def resolve_cmd(key, cmd):
    """設定値 key のコマンドを実行して値を取得する"""
    try:
        res = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=15)
    except Exception as e:
        warn(f"{key} の実行に失敗: {e}")
        return ""
    if res.returncode != 0:
        warn(f"{key} が異常終了 (rc={res.returncode}): {res.stderr.strip()[:200]}")
        return ""
    return res.stdout.strip()


# ---------------------------------------------------------------------------
# ユーティリティ
# ---------------------------------------------------------------------------
def run(cmd, **kw):
    return subprocess.run(cmd, check=True, **kw)


def ms_to_hms(ms):
    s = int(ms // 1000)
    return f"{s//3600:02d}:{(s%3600)//60:02d}:{s%60:02d}"


# ---------------------------------------------------------------------------
# 音声処理
# ---------------------------------------------------------------------------
def count_audio_tracks(path):
    out = run(
        ["ffprobe", "-v", "error", "-select_streams", "a",
         "-show_entries", "stream=index", "-of", "csv=p=0", str(path)],
        capture_output=True, text=True,
    ).stdout.strip()
    return len([l for l in out.splitlines() if l.strip()])


def extract_track(src, track_index, dst, normalize=True):
    """指定オーディオトラックを 16kHz mono WAV に変換。

    既定でラウドネス正規化をかける。マイクのモニタ経路は録音レベルが
    低くなりがちで(実機で -48dB)、そのまま whisper に渡すと発話を拾えず
    幻聴(「ご視聴ありがとうございました」の連発)になる。
    """
    cmd = ["ffmpeg", "-y", "-i", str(src), "-map", f"0:a:{track_index}"]
    if normalize:
        cmd += ["-af", "loudnorm=I=-16:TP=-1.5:LRA=11"]
    cmd += ["-ac", "1", "-ar", "16000", "-c:a", "pcm_s16le", str(dst)]
    run(cmd, capture_output=True)


def transcribe(wav, cfg, tmpdir):
    """whisper-cli で文字起こし。segments のリスト [{from_ms, text}] を返す"""
    prefix = str(Path(tmpdir) / (Path(wav).stem + "_out"))
    cmd = [
        cfg["whisper_bin"], "-m", cfg["model"], "-f", str(wav),
        "-l", cfg["language"], "-oj", "-of", prefix, "-np",
        "-sns",                      # 非発話トークンを抑制
    ]
    # VAD で発話区間だけを切り出してから認識する。長い無音を含む音声を
    # そのまま渡すと whisper が幻聴を返すため、ライブ字幕(whisper-stream)が
    # VADモードで安定しているのと同じ土俵に乗せる。
    vad = Path(cfg["vad_model"]).expanduser()
    if vad.exists():
        cmd += ["--vad", "--vad-model", str(vad)]
    else:
        warn(f"VADモデルが無いため無効化します: {vad}")
    run(cmd, capture_output=True, text=True)
    data = json.loads(Path(prefix + ".json").read_text())
    segs = []
    for t in data.get("transcription", []):
        text = (t.get("text") or "").strip()
        if not text:
            continue
        segs.append({"from": t["offsets"]["from"], "text": text})
    return segs


# ---------------------------------------------------------------------------
# マージ & 整形
# ---------------------------------------------------------------------------
def merge_segments(tracks):
    """tracks = [(label, segs), ...] を時系列にマージ"""
    merged = []
    for label, segs in tracks:
        for s in segs:
            merged.append({"from": s["from"], "label": label, "text": s["text"]})
    merged.sort(key=lambda x: x["from"])
    return merged


def format_transcript(merged, with_labels):
    lines = []
    for s in merged:
        ts = ms_to_hms(s["from"])
        if with_labels:
            lines.append(f"[{ts}] {s['label']}: {s['text']}")
        else:
            lines.append(f"[{ts}] {s['text']}")
    return "\n".join(lines)


# ---------------------------------------------------------------------------
# 議事録生成 (claude -p)
# ---------------------------------------------------------------------------
MINUTES_PROMPT = """\
あなたは優秀な議事録作成アシスタントです。
以下は会議の文字起こしです(各行は [時刻] 話者: 発言 の形式。話者ラベルが無い場合もあります)。
これを読み、日本語で簡潔かつ構造化された議事録を Markdown で作成してください。

必ず次のセクションを含めること(該当が無ければ「特になし」と記載):

## 概要
3〜5行で会議の目的と結論を要約。

## 主要な論点
- 箇条書きで議論された論点。

## 決定事項
- 決まったことを箇条書き。

## ToDo / ネクストアクション
- 担当者(分かれば) / 内容 / 期限(分かれば)
(チェックボックス `- [ ]` や TODO / DONE は付けない。ふつうの箇条書きにする)

## 補足・備考
- 重要な発言や保留事項など。

文字起こしの誤変換と思われる箇所は文脈から自然に補正してよい。
前置きや後書きは不要。Markdown 本文のみを出力すること。

--- 文字起こしここから ---
{transcript}
--- 文字起こしここまで ---
"""


def generate_minutes(transcript, cfg):
    prompt = MINUTES_PROMPT.format(transcript=transcript)
    try:
        res = subprocess.run(
            [cfg["claude_bin"], "-p"],
            input=prompt, capture_output=True, text=True, timeout=600,
        )
    except FileNotFoundError:
        warn("claude CLI が見つからないため議事録生成をスキップ")
        return None
    if res.returncode != 0:
        warn(f"claude 実行失敗 (rc={res.returncode}): {res.stderr.strip()[:300]}")
        return None
    return res.stdout.strip()


# ---------------------------------------------------------------------------
# Logseq 書き込み
# ---------------------------------------------------------------------------
def make_audio_asset(src, n_tracks, dst, bitrate):
    """録音の全トラックを1本にミックスして m4a (AAC) に変換"""
    if n_tracks >= 2:
        inputs = "".join(f"[0:a:{i}]" for i in range(n_tracks))
        fc = f"{inputs}amix=inputs={n_tracks}:normalize=0[a]"
        cmd = ["ffmpeg", "-y", "-i", str(src),
               "-filter_complex", fc, "-map", "[a]",
               "-c:a", "aac", "-b:a", bitrate, str(dst)]
    else:
        cmd = ["ffmpeg", "-y", "-i", str(src),
               "-map", "0:a:0", "-c:a", "aac", "-b:a", bitrate, str(dst)]
    run(cmd, capture_output=True)


def nextcloud_credentials(cfg):
    """(url, user, password) を返す。未設定または取得失敗なら None"""
    keys = ("nextcloud_url_cmd", "nextcloud_user_cmd", "nextcloud_password_cmd")
    if not all(cfg[k] for k in keys):
        return None
    values = [resolve_cmd(k, cfg[k]) for k in keys]
    return values if all(values) else None


def attach_audio(cfg, src, n_tracks, name):
    """録音を m4a にして Nextcloud に置き、ページに書く Markdown を返す"""
    with tempfile.TemporaryDirectory() as tmp:
        m4a = Path(tmp) / name
        try:
            make_audio_asset(src, n_tracks, m4a, cfg["audio_bitrate"])
        except subprocess.CalledProcessError as e:
            warn(f"音声変換に失敗、添付をスキップ: {e}")
            return None
        return upload_to_nextcloud(cfg, m4a, name, "録音")


def upload_to_nextcloud(cfg, path, name, label):
    """path を Nextcloud に置いてリンクの Markdown を返す。置けなければ None"""
    credentials = nextcloud_credentials(cfg)
    if not credentials:
        warn(f"Nextcloud が未設定のため{label}の添付をスキップ")
        return None
    try:
        return f"[{label}]({nextcloud.upload(path, name, *credentials)})"
    except nextcloud.UploadError as e:
        warn(f"Nextcloud へのアップロードに失敗、{label}の添付をスキップ: {e}")
        return None


# logseq-db write はこれらで始まるブロックをタスクにする。
TASK_PREFIX = re.compile(r"^(?:\[[ xX]\]\s+)?(?:(?:TODO|DONE|DOING|LATER|NOW)\s+)?")


def md_to_blocks(md):
    """Markdown を Logseq のブロックツリーに変換(logseq-write スキル規約準拠)。
       ## 見出し → トップレベル / 配下の段落・箇条書きは子ブロック。
       チェックボックスや先頭の TODO / DONE は外す。会議の ToDo は他人の担当も
       含むので、Logseq のタスクにすると自分のタスク一覧に混ざる。
       返り値: [{"content": str, "children": [...]}, ...]"""
    root, section, subsection = [], None, None

    def container():
        if subsection is not None:
            return subsection["children"]
        if section is not None:
            return section["children"]
        return root

    for raw in md.splitlines():
        s = raw.strip()
        if not s or s == "---":
            continue
        if s.startswith("# ") and not s.startswith("## "):
            continue                                   # H1 はスキップ
        if s.startswith("## "):
            section = {"content": s, "children": []}    # 見出しは独立ブロック
            subsection = None
            root.append(section)
            continue
        if s.startswith("### "):
            subsection = {"content": s, "children": []}
            (section["children"] if section else root).append(subsection)
            continue
        m = re.match(r"^[-*]\s+(.*)$", s)               # 箇条書き
        if m:
            item = TASK_PREFIX.sub("", m.group(1))
            container().append({"content": item, "children": []})
            continue
        container().append({"content": TASK_PREFIX.sub("", s), "children": []})   # 段落
    return root


def _clean_tree(nodes):
    """children が空のキーを除去"""
    out = []
    for n in nodes:
        node = {"content": n["content"]}
        kids = _clean_tree(n.get("children") or [])
        if kids:
            node["children"] = kids
        out.append(node)
    return out


def write_to_logseq(cfg, page_name, minutes_md, transcript, meta,
                    audio_md=None, transcript_md=None):
    tree = []
    if audio_md:
        tree.append({"content": "## 録音", "children": [{"content": audio_md}]})
    if minutes_md:
        tree.extend(md_to_blocks(minutes_md))
    # 全文は長く、ページに埋めると重くなるので、置けたらリンクにする
    tree.append({"content": "## 文字起こし全文",
                 "children": [{"content": transcript_md or transcript}]})
    properties = {"type": "meeting", "date": f"[[{meta['date']}]]", "source": meta["source"]}
    team = meta.get("team")
    if team:
        properties["team"] = f"[[{team}]]"
        if team in TEAM_PROJECTS:
            properties["project"] = f"[[{TEAM_PROJECTS[team]}]]"
    tags = page_tags(page_name)
    if tags:
        properties["tags"] = " ".join(tags)
    spec = {
        "page": page_name,
        "properties": properties,
        "blocks": _clean_tree(tree),
    }
    try:
        res = subprocess.run(["logseq-db", "write"], input=json.dumps(spec, ensure_ascii=False),
                             capture_output=True, text=True)
    except OSError as e:
        warn(f"logseq-db が無いため Logseq 書き込みをスキップ: {e}")
        return False
    if res.returncode != 0:
        warn(f"Logseq 書き込み失敗: {res.stderr.strip()}")
        return False
    return True


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------
def main():
    ap = argparse.ArgumentParser(prog="mtg-minutes",
                                 description="録音 → 文字起こし → 議事録 → Logseq")
    ap.add_argument("recording", nargs="?", default=None,
                    help="録音ファイル (mkv/mp4/m4a/wav)")
    ap.add_argument("--transcript", default=None, metavar="PATH",
                    help="録音の代わりに既存の文字起こしテキストから議事録を作る"
                         "(mtg / mtg-live のライブ字幕ログなど)")
    ap.add_argument("--title", default="", help="会議タイトル(Logseqページ名に使用)")
    ap.add_argument("--team", default=None,
                    help="会議録を結ぶチームのページ(既定:タイトルの電力Hub / PFチーム から判定)")
    ap.add_argument("--self-track", type=int, default=0, help="自分のマイクのトラック番号 (既定:0)")
    ap.add_argument("--other-track", type=int, default=1, help="相手の音声のトラック番号 (既定:1)")
    ap.add_argument("--no-minutes", action="store_true", help="議事録生成をスキップ")
    ap.add_argument("--no-logseq", action="store_true", help="Logseq書き込みをスキップ")
    ap.add_argument("--keep-wav", action="store_true", help="中間WAVを残す")
    ap.add_argument("--attach-audio", dest="attach_audio", action="store_true",
                    default=None, help="録音音声をLogseqに添付(既定:config)")
    ap.add_argument("--no-attach-audio", dest="attach_audio", action="store_false",
                    help="録音音声を添付しない")
    args = ap.parse_args()

    cfg = load_config()
    if bool(args.recording) == bool(args.transcript):
        die("録音ファイル か --transcript のどちらか一方を指定してください。")

    now = dt.datetime.now()
    src = None          # 文字起こしモードでは録音が無い(音声添付もスキップされる)
    n_tracks = 0
    if args.transcript:
        tr_path = Path(args.transcript).expanduser()
        if not tr_path.exists():
            die(f"文字起こしファイルが見つかりません: {tr_path}")
        title = args.title or tr_path.stem
        source_name = tr_path.name
    else:
        src = Path(args.recording).expanduser()
        if not src.exists():
            die(f"録音ファイルが見つかりません: {src}")
        if not Path(cfg["model"]).exists():
            die(f"whisperモデルが見つかりません: {cfg['model']}\n  先にモデルをダウンロードしてください。")
        title = args.title or src.stem
        source_name = src.name

    out_dir = Path(cfg["output_dir"]).expanduser() / now.strftime("%Y%m%d_%H%M%S")
    out_dir.mkdir(parents=True, exist_ok=True)

    if args.transcript:
        # ライブ字幕ログ等、すでに話者ラベル付きのテキストをそのまま使う
        transcript = tr_path.read_text()
        if not transcript.strip():
            die(f"文字起こしファイルが空です: {tr_path}")
        info(f"文字起こしを読み込みました: {tr_path} ({len(transcript.splitlines())}行)")
    else:
        n_tracks = count_audio_tracks(src)
        info(f"音声トラック数: {n_tracks}")

        tmpdir = tempfile.mkdtemp(prefix="mtg_")
        tracks_to_process = []
        if n_tracks >= 2:
            plan = [(args.self_track, cfg["self_label"]), (args.other_track, cfg["other_label"])]
            with_labels = True
        else:
            plan = [(0, cfg["self_label"])]
            with_labels = False
            warn("トラックが1つのみ。話者ラベルなしで処理します。")

        for idx, label in plan:
            wav = Path(tmpdir) / f"track{idx}.wav"
            info(f"トラック{idx} ({label}) を抽出中…")
            extract_track(src, idx, wav, normalize=cfg["normalize"])
            info(f"トラック{idx} ({label}) を文字起こし中… (whisper)")
            segs = transcribe(wav, cfg, tmpdir)
            info(f"  → {len(segs)} セグメント")
            tracks_to_process.append((label, segs))
            if args.keep_wav:
                shutil.copy(wav, out_dir / wav.name)

        merged = merge_segments(tracks_to_process)
        transcript = format_transcript(merged, with_labels)

    (out_dir / "transcript.txt").write_text(transcript)
    info(f"文字起こし保存: {out_dir/'transcript.txt'}")

    minutes_md = None
    if not args.no_minutes:
        info("議事録を生成中… (claude)")
        minutes_md = generate_minutes(transcript, cfg)
        if minutes_md:
            (out_dir / "minutes.md").write_text(minutes_md)
            info(f"議事録保存: {out_dir/'minutes.md'}")

    if not args.no_logseq:
        title, team = team_title(title)
        team = args.team or team
        page_name = f"{cfg['logseq_page_prefix']} {now.strftime('%Y-%m-%d')} {title}".strip()
        ts = now.strftime("%Y%m%d_%H%M%S")
        audio_md = None
        with tempfile.TemporaryDirectory() as tmp:
            tr_path = Path(tmp) / f"transcript_{ts}.txt"
            tr_path.write_text(transcript)
            transcript_md = upload_to_nextcloud(cfg, tr_path, tr_path.name, "文字起こし全文")
        # 録音音声の添付(--transcript モードでは元音声が無いのでスキップ)
        attach = cfg["attach_audio"] if args.attach_audio is None else args.attach_audio
        if attach and src is not None:
            asset_name = f"mtg_{ts}.m4a"
            info(f"録音音声を変換・添付中… ({asset_name})")
            audio_md = attach_audio(cfg, src, n_tracks, asset_name)
        info(f"Logseqページ作成中: {page_name}")
        ok = write_to_logseq(cfg, page_name,
                             minutes_md, transcript,
                             {"date": now.strftime("%Y-%m-%d"), "source": source_name, "team": team},
                             audio_md=audio_md, transcript_md=transcript_md)
        if ok:
            info(f"Logseq書き込み完了: 「{page_name}」")

    print(f"\n\033[32m✔ 完了\033[0m  出力先: {out_dir}")
    if minutes_md:
        print("\n" + "=" * 60)
        print(minutes_md)


if __name__ == "__main__":
    main()
